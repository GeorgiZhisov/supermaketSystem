@{ ViewData["Title"] = "401 Unauthorized"; }
<div class="container py-5 text-center">
    <i class="bi bi-lock text-danger" style="font-size:6rem;"></i>
    <h1 class="display-1 fw-bold text-danger">401</h1>
    <h2 class="mb-3">Unauthorized</h2>
    <p class="text-muted mb-4">You don't have permission to access this page. Please log in.</p>
    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-success btn-lg">
        <i class="bi bi-box-arrow-in-right me-2"></i>Login
    </a>
</div>
