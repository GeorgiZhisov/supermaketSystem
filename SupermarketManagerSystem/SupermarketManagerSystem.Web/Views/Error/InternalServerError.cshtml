@{ ViewData["Title"] = "500 Internal Server Error"; }
<div class="container py-5 text-center">
    <i class="bi bi-bug text-danger" style="font-size:6rem;"></i>
    <h1 class="display-1 fw-bold text-danger">500</h1>
    <h2 class="mb-3">Something Went Wrong</h2>
    <p class="text-muted mb-4">An internal server error occurred. Please try again later.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-success btn-lg">
        <i class="bi bi-house me-2"></i>Back to Home
    </a>
</div>
