@model IEnumerable<SupermarketManagerSystem.Web.ViewModels.SupplierViewModel>
@{ ViewData["Title"] = "Suppliers"; }
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-truck text-warning me-2"></i>Suppliers</h2>
        @if (User.IsInRole("Administrator"))
        {
            <a asp-action="Add" class="btn btn-warning text-white"><i class="bi bi-plus-lg me-1"></i>Add Supplier</a>
        }
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Company</th><th>Contact</th><th>Email</th><th>Phone</th><th>Products</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-semibold">@s.Name</td>
                        <td>@(s.ContactPerson ?? "—")</td>
                        <td>@(s.Email != null ? $"<a href='mailto:{s.Email}'>{s.Email}</a>" : "—")</td>
                        <td>@(s.Phone ?? "—")</td>
                        <td><span class="badge bg-info text-dark">@s.ProductCount</span></td>
                        <td><span class="badge @(s.IsActive ? "bg-success" : "bg-secondary")">@(s.IsActive ? "Active" : "Inactive")</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            @if (User.IsInRole("Administrator"))
                            {
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-warning ms-1"><i class="bi bi-pencil"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
