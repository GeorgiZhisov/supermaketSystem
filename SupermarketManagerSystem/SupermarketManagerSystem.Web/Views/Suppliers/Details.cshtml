@model SupermarketManagerSystem.Web.ViewModels.SupplierViewModel
@{ ViewData["Title"] = Model.Name; }
<div class="container py-4">
    <div class="card p-4" style="max-width:600px;">
        <h2 class="fw-bold mb-3">@Model.Name</h2>
        <dl class="row">
            <dt class="col-sm-4">Contact Person</dt><dd class="col-sm-8">@(Model.ContactPerson ?? "—")</dd>
            <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@(Model.Email ?? "—")</dd>
            <dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@(Model.Phone ?? "—")</dd>
            <dt class="col-sm-4">Address</dt><dd class="col-sm-8">@(Model.Address ?? "—")</dd>
            <dt class="col-sm-4">Products</dt><dd class="col-sm-8">@Model.ProductCount</dd>
            <dt class="col-sm-4">Status</dt><dd class="col-sm-8"><span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">@(Model.IsActive ? "Active" : "Inactive")</span></dd>
        </dl>
        <a asp-action="All" class="btn btn-outline-secondary btn-sm">← Back</a>
    </div>
</div>
