@model SupermarketManagerSystem.Web.ViewModels.ProductFormViewModel
@{ ViewData["Title"] = "Add Product"; }
<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-plus-circle text-success me-2"></i>Add Product</h2>
    <div class="card p-4" style="max-width: 750px;">
        <form asp-action="Add" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="validation-summary"></div>
            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Whole Milk 1L" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Barcode" class="form-label fw-semibold"></label>
                    <input asp-for="Barcode" class="form-control" placeholder="e.g. 5901234123457" />
                    <span asp-validation-for="Barcode" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-md-4">
                    <label asp-for="Price" class="form-label fw-semibold"></label>
                    <div class="input-group"><span class="input-group-text">BGN</span><input asp-for="Price" class="form-control" type="number" step="0.01" /></div>
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CostPrice" class="form-label fw-semibold"></label>
                    <div class="input-group"><span class="input-group-text">BGN</span><input asp-for="CostPrice" class="form-control" type="number" step="0.01" /></div>
                </div>
                <div class="col-md-4">
                    <label asp-for="Unit" class="form-label fw-semibold"></label>
                    <input asp-for="Unit" class="form-control" placeholder="kg, pcs, l..." />
                </div>
                <div class="col-md-4">
                    <label asp-for="StockQuantity" class="form-label fw-semibold"></label>
                    <input asp-for="StockQuantity" class="form-control" type="number" />
                </div>
                <div class="col-md-4">
                    <label asp-for="MinimumStockLevel" class="form-label fw-semibold"></label>
                    <input asp-for="MinimumStockLevel" class="form-control" type="number" />
                </div>
                <div class="col-md-4">
                    <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                    <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                        <option value="">— Select —</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SupplierId" class="form-label fw-semibold"></label>
                    <select asp-for="SupplierId" asp-items="Model.Suppliers" class="form-select">
                        <option value="">— None —</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="ImageUrl" class="form-label fw-semibold"></label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-success px-4"><i class="bi bi-check-lg me-1"></i>Save Product</button>
                <a asp-action="All" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
