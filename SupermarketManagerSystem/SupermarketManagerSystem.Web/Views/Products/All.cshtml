@model IEnumerable<SupermarketManagerSystem.Web.ViewModels.ProductListViewModel>
@{ ViewData["Title"] = "Products"; }
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-box-seam text-success me-2"></i>Products</h2>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Add" class="btn btn-success"><i class="bi bi-plus-lg me-1"></i>Add Product</a>
        }
    </div>

    <div class="card p-3 mb-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-semibold">Search</label>
                <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control" placeholder="Name or barcode..." />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Category</label>
                <select name="categoryId" asp-items="ViewBag.Categories" class="form-select">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-success w-100"><i class="bi bi-search me-1"></i>Search</button>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>No products found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Name</th><th>Barcode</th><th>Category</th><th>Price</th>
                        <th>Stock</th><th>Supplier</th><th>Status</th><th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@p.Name</td>
                            <td><code>@p.Barcode</code></td>
                            <td>@p.CategoryName</td>
                            <td>@p.Price.ToString("C")</td>
                            <td>
                                @if (p.IsLowStock)
                                {
                                    <span class="badge bg-danger">@p.StockQuantity <i class="bi bi-exclamation-triangle ms-1"></i></span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@p.StockQuantity</span>
                                }
                            </td>
                            <td>@(p.SupplierName ?? "—")</td>
                            <td>
                                <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">
                                    @(p.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-warning ms-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
