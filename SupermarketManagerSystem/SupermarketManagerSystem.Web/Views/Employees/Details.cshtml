@model SupermarketManagerSystem.Web.ViewModels.EmployeeViewModel
@{ ViewData["Title"] = Model.FullName; }
<div class="container py-4">
    <div class="card p-4" style="max-width:550px;">
        <h2 class="fw-bold mb-1">@Model.FullName</h2>
        <span class="badge bg-info text-dark mb-3">@Model.Position</span>
        <dl class="row">
            <dt class="col-sm-5">Email</dt><dd class="col-sm-7">@(Model.Email ?? "—")</dd>
            <dt class="col-sm-5">Phone</dt><dd class="col-sm-7">@(Model.Phone ?? "—")</dd>
            <dt class="col-sm-5">Hire Date</dt><dd class="col-sm-7">@Model.HireDate.ToString("dd MMM yyyy")</dd>
            <dt class="col-sm-5">Status</dt><dd class="col-sm-7"><span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">@(Model.IsActive ? "Active" : "Inactive")</span></dd>
            @if (!string.IsNullOrEmpty(Model.Notes)) { <dt class="col-sm-5">Notes</dt><dd class="col-sm-7">@Model.Notes</dd> }
        </dl>
        <a asp-action="All" class="btn btn-outline-secondary btn-sm">← Back</a>
    </div>
</div>
