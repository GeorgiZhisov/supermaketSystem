@model IEnumerable<SupermarketManagerSystem.Web.ViewModels.EmployeeViewModel>
@{ ViewData["Title"] = "Employees"; }
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-people text-info me-2"></i>Employees</h2>
        <a asp-action="Add" class="btn btn-info text-white"><i class="bi bi-plus-lg me-1"></i>Add Employee</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Name</th><th>Position</th><th>Email</th><th>Phone</th><th>Hire Date</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td class="fw-semibold">@e.FullName</td>
                        <td><span class="badge bg-info text-dark">@e.Position</span></td>
                        <td>@(e.Email ?? "—")</td>
                        <td>@(e.Phone ?? "—")</td>
                        <td>@e.HireDate.ToString("dd MMM yyyy")</td>
                        <td><span class="badge @(e.IsActive ? "bg-success" : "bg-secondary")">@(e.IsActive ? "Active" : "Inactive")</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-warning ms-1"><i class="bi bi-pencil"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
