@model SupermarketManagerSystem.Web.ViewModels.RestockRequestViewModel
@{ ViewData["Title"] = "New Restock Request"; }
<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-arrow-repeat text-danger me-2"></i>New Restock Request</h2>
    <div class="card p-4" style="max-width:600px;">
        <form asp-action="Add" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-12"><label asp-for="ProductId" class="form-label fw-semibold"></label><select asp-for="ProductId" asp-items="Model.Products" class="form-select"><option value="">— Select Product —</option></select><span asp-validation-for="ProductId" class="text-danger small"></span></div>
                <div class="col-12"><label asp-for="SupplierId" class="form-label fw-semibold"></label><select asp-for="SupplierId" asp-items="Model.Suppliers" class="form-select"><option value="">— Select Supplier (optional) —</option></select></div>
                <div class="col-md-6"><label asp-for="RequestedQuantity" class="form-label fw-semibold"></label><input asp-for="RequestedQuantity" class="form-control" type="number" min="1" /><span asp-validation-for="RequestedQuantity" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="EstimatedCost" class="form-label fw-semibold"></label><div class="input-group"><span class="input-group-text">BGN</span><input asp-for="EstimatedCost" class="form-control" type="number" step="0.01" /></div></div>
                <div class="col-12"><label asp-for="Notes" class="form-label fw-semibold"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-danger">Submit Request</button>
                <a asp-action="All" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
