@model IEnumerable<SupermarketManagerSystem.Web.ViewModels.CategoryViewModel>
@{ ViewData["Title"] = "Categories"; }
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-tags text-primary me-2"></i>Categories</h2>
        @if (User.IsInRole("Administrator"))
        {
            <a asp-action="Add" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Category</a>
        }
    </div>
    <div class="row g-4">
        @foreach (var c in Model)
        {
            <div class="col-md-4">
                <div class="card p-3 h-100">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="fw-bold mb-1">@c.Name</h5>
                        <span class="badge bg-primary">@c.ProductCount products</span>
                    </div>
                    <p class="text-muted small mb-3">@(c.Description ?? "No description.")</p>
                    <div class="mt-auto d-flex gap-2">
                        <a asp-controller="Products" asp-action="All" asp-route-categoryId="@c.Id"
                           class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye me-1"></i>View Products
                        </a>
                        @if (User.IsInRole("Administrator"))
                        {
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
